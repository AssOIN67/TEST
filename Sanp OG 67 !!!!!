
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ตัวแปร
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local HRP = Character:WaitForChild("HumanoidRootPart")

local isRunning = false
local sitConnection = nil

local heightOffset = -7     
local speed = 0.8           
local duration = 0.1        

local function StartSitReal()
    if isRunning then return end
    isRunning = true

    Character = LocalPlayer.Character
    if not Character then isRunning = false; return end
    Humanoid = Character:FindFirstChild("Humanoid")
    HRP = Character:FindFirstChild("HumanoidRootPart")
    if not Humanoid or not HRP then isRunning = false; return end

    Humanoid.Sit = true

    sitConnection = RunService.RenderStepped:Connect(function()
        if HRP and HRP.Parent then
            local targetY = HRP.Position.Y + heightOffset
            local currentCFrame = HRP.CFrame
            local targetCFrame = CFrame.new(currentCFrame.X, targetY, currentCFrame.Z) * (currentCFrame - currentCFrame.Position)
            HRP.CFrame = currentCFrame:Lerp(targetCFrame, speed)
        end
    end)
end

local function StopSitReal()
    if sitConnection then
        sitConnection:Disconnect()
        sitConnection = nil
    end
    if Humanoid then
        Humanoid.Sit = false
    end
    isRunning = false
end

local ScreenGui = Instance.new("ScreenGui")
local Frame = Instance.new("Frame")
local ActionButton = Instance.new("TextButton")
local StatusLabel = Instance.new("TextLabel")

ScreenGui.Name = "SitRealOneShotGUI"
ScreenGui.Parent = game:GetService("CoreGui")
ScreenGui.ResetOnSpawn = false

Frame.Parent = ScreenGui
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
Frame.BorderSizePixel = 2
Frame.BorderColor3 = Color3.fromRGB(255, 50, 50)
Frame.Position = UDim2.new(0, 10, 0.5, -40)
Frame.Size = UDim2.new(0, 200, 0, 80)
Frame.Active = true
Frame.Draggable = true

ActionButton.Parent = Frame
ActionButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
ActionButton.BorderSizePixel = 0
ActionButton.Position = UDim2.new(0, 10, 0, 10)
ActionButton.Size = UDim2.new(0, 180, 0, 40)
ActionButton.Font = Enum.Font.GothamBold
ActionButton.Text = "จมดิน 0.1 วิ"
ActionButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ActionButton.TextSize = 16

StatusLabel.Parent = Frame
StatusLabel.BackgroundTransparency = 1
StatusLabel.Position = UDim2.new(0, 10, 0, 55)
StatusLabel.Size = UDim2.new(0, 180, 0, 20)
StatusLabel.Font = Enum.Font.Gotham
StatusLabel.Text = "พร้อมใช้งาน"
StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
StatusLabel.TextSize = 13

ActionButton.MouseButton1Click:Connect(function()
    if isRunning then
        StatusLabel.Text = "กำลังทำงาน..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
        return
    end

    StatusLabel.Text = "จมดิน..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    ActionButton.Text = "กำลังจม..."

    StartSitReal()

    task.wait(duration)

    StopSitReal()
    StatusLabel.Text = "เสร็จสิ้น"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    ActionButton.Text = "จมดิน 0.1 วิ"

    task.wait(0.5)
    StatusLabel.Text = "พร้อมใช้งาน"
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    task.wait(1)
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
    HRP = newChar:WaitForChild("HumanoidRootPart")
end)

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Delete then
        StopSitReal()
        ScreenGui:Destroy()
    end
end)
